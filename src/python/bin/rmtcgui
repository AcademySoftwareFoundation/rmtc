"""
Overall tool to invoke the other GUI objects
"""

import os

from rmtc.gui import GUI
from rmtc import System
from rmtc.system import Config
from rmtc.gui.common.dialogs import CredentialsDialog

import argparse
parser = argparse.ArgumentParser(
    description = "Run RMTC - populate ML artifacts, start and monitor training, run inferences and explore provenance"
)
parser.add_argument(
    "--config",
    help="Specify a config",
)
parser.add_argument(
    "--user",
    help="Specify a user",
)
parser.add_argument(
    "--pw",
    help="Specify a password",
)
args = parser.parse_args()

if __name__ == '__main__':

    # Query password and user name
    username = args.user or os.environ.get("RMTC_USER")
    password = args.pw or os.environ.get("RMTC_PW")
    config = args.config or os.environ.get("RMTC_CONFIG_NAME")
    credentials = (username, password)

    # create system
    rmtc_sys = System(
        config = Config(name=config),
        credentials = credentials,
    )

    # run
    gui = GUI(rmtc_sys)
    gui.run()