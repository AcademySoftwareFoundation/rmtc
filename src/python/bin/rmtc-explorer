"""
Basic nodal graph application to trace through the provenance.

Wraps the GUI layer in the RMTC module
"""

import os

from rmtc_core.gui.signalbox.widgets import SignalBox
from rmtc_core.gui.common.widgets import Toolbar
from rmtc_core import System
from rmtc.system import Config

from Qt import QtWidgets, QtCore, QtGui

import argparse
parser = argparse.ArgumentParser(
    description = "RMTC Provenance Explorer."
)
parser.add_argument(
    "--store_name",
    help="Specify a store name",
    default=None,
)
args = parser.parse_args()

if __name__ == '__main__':
    # setup config
    overrides = {}
    if args.store_name is not None:
        overrides |= {"rmtc_store": {"name": args.store_name}}
    rmtc_sys = System(
        config = Config(overrides=overrides),
    )
    
    # create
    asset_path = f"{os.getenv('RMTC_RESOURCES')}/icons"
    app = QtWidgets.QApplication([])
    
    signalbox = SignalBox(rmtc_sys)
    toolbar = Toolbar(rmtc_sys)

    main_window = QtWidgets.QMainWindow()
    main_window.setWindowTitle("RMTC")
    main_window.setWindowIcon(QtGui.QIcon(f"{asset_path}/rmtc.svg"))
    pos = QtGui.QCursor.pos()
    main_window.setGeometry(QtCore.QRect(pos.x(), pos.y(), 1280, 720))
    main_window.addToolBar(toolbar)
    main_window.setCentralWidget(signalbox)
    main_window.show()

    app.exec_()