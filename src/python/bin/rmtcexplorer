"""
Basic nodal graph application to trace through the provenance.

Wraps the GUI layer in the RMTC module
"""

import os

from rmtc.gui.provenance.widgets import SignalBox
from rmtc.gui.common.widgets import Toolbar
from rmtc import System
from rmtc.system import Config
from rmtc.gui.common.dialogs import CredentialsDialog


from Qt import QtWidgets, QtCore, QtGui

import argparse
parser = argparse.ArgumentParser(
    description = "RMTC Provenance Explorer."
)
parser.add_argument(
    "--config",
    help="Specify a config",
)
args = parser.parse_args()

if __name__ == '__main__':

    # Query password and user name
    username = os.environ.get("RMTC_USER")
    password = os.environ.get("RMTC_PW")
    credentials = (username, password)
    if username is None or password is None:
        dialog = CredentialsDialog(credentials)
        if dialog.exec_():
            credentials = dialog.credentials

    # setup config
    rmtc_sys = System(
        config = Config(name=args.config),
        credentials = credentials,
    )

    # attempt to open a connection
    if not rmtc_sys.is_valid():
        rmtc_sys.log.error("Invalid system - login credentials or subsystems not valid")
        exit(1)

    # create
    asset_path = f"{os.getenv('RMTC_RESOURCES')}/icons"
    app = QtWidgets.QApplication([])
    
    signalbox = SignalBox(rmtc_sys)
    toolbar = Toolbar(rmtc_sys)

    main_window = QtWidgets.QMainWindow()
    main_window.setWindowTitle("RMTC")
    main_window.setWindowIcon(QtGui.QIcon(f"{asset_path}/rmtc.svg"))
    pos = QtGui.QCursor.pos()
    main_window.setGeometry(QtCore.QRect(pos.x(), pos.y(), 1280, 720))
    main_window.addToolBar(toolbar)
    main_window.setCentralWidget(signalbox)
    main_window.show()

    app.exec_()