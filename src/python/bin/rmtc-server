"""
Server wrapper for the system interface.

This is currently usused, but serves to point a way in
which we could move to a server/REST architecture
"""

from rmtc.system import Config
from rmtc_core import System
from rmtc_core.interface.rest.flask import Server

import argparse
parser = argparse.ArgumentParser(
    description = "Run RMTC Explorer."
)
parser.add_argument(
    "--store_name",
    help="Specify a store name",
    default=None,
)
parser.add_argument(
    "--dev",
    help="Run in dev mode",
    default=False,
    action='store_true',
)
args = parser.parse_args()

if __name__ == '__main__':
    overrides = {}
    if args.store_name is not None:
        overrides |= {"rmtc_store": {"name": args.store_name}}
    if args.dev:        
        overrides |= {"rmtc_system": {"mode": "DEVELOPMENT"}}
    rmtc_sys = System(
        config = Config(overrides=overrides),
    )
    server = Server(rmtc_sys)
    server.run()
