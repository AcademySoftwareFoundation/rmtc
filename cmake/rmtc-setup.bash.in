echo "Setting RMTC environment variables"

export RMTC_CONFIG="@CONFIG_INSTALL_DIR@"
export RMTC_RESOURCES="@RESOURCES_INSTALL_DIR@"
export RMTC_HOME="@INSTALL_HOME@"
export RMTC_VERSION="@PROJECT_VERSION@"
export PATH="@PYTHON_BIN_INSTALL_DIR@:@BIN_INSTALL_DIR@:$PATH"
export PYTHONPATH="@PYTHON_LIB_INSTALL_DIR@:$PYTHONPATH"
